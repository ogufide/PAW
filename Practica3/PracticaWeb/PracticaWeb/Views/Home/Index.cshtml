@{
    ViewData["Title"] = "Home Page";
}

<div class="container text-center my-5">
    <div class="bg-light rounded-lg shadow-lg p-4">
        <h1 class="display-4 font-weight-bold text-primary mb-4">¡Bienvenido al Sistema de Gestión!</h1>
        <h3 class="font-weight-normal mb-4 text-secondary" style="font-size: 1.2rem;">
            Aquí podrás visualizar todos los productos, ordenados por estado, comenzando por los pendientes para un seguimiento eficiente.
        </h3>
        <h3 class="font-weight-normal text-secondary" style="font-size: 1.2rem;">
            Además, podrás consultar los detalles sobre los pagos asociados a cada producto, facilitando la gestión y verificación del estado de las transacciones.
        </h3>
    </div>
</div>
