@model List<WEB.Entities.Clase>

@{
    ViewData["Title"] = "Clase";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table id="tabla-Clases" class="table table-hover">
    <thead>
        <tr>
            <th>Id_clase</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>IdInstructor</th>
            <th>Horario</th>
            <th>Duracion</th>
            <th>CapacidadMaxima</th>
            <th>Estado</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_clase</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.IdInstructor</td>
                <td>@item.Horario</td>
                <td>@item.Duracion</td>
                <td>@item.CapacidadMaxima</td>
                <td>@item.Estado</td>
                
                <td>
                    <button type="button" class="btn btn-primary Modales" data-toggle="modal" data-target="#ModalClase"
                            data-id="@item.Id_clase" data-name="@item.Nombre">
                        <i class="fa fa-pen"></i>
                    </button>

                    <a class="btn btn-primary" href="@Url.Action("UpdateClase", "Clases", new { q = item.Id_clase })">
                        <i class="fa fa-user"></i>
                    </a>
                    
                 </td>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/ReadClases.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>