@model WEB.Entities.Clase

@{
    ViewData["Title"] = "CreateClase";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2> Agregar Clase</h2>
    </div>
</div>
<div class="container mt-2">
    @using (Html.BeginForm("CreateClase", "Clases", FormMethod.Post, new { id = "formAgregar" }))
    {

        <label for="Nombre">Nombre</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control form-control-user", @placeholder = "Nombre", @required = "true", @id = "Nombre" })
        </div>

        <label for="Descripcion">Descripcion</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Descripcion, new { @type = "text", @class = "form-control", @placeholder = "Descripcion", @required = "true", @id = "Descripcion" })
        </div>

        <label for="IdInstructor">Id Instructor</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.IdInstructor, new { @type = "int", @class = "form-control", @placeholder = "IdInstructor", @required = "true", @id = "IdInstructor" })
        </div>

        <label for="Horario">Horario</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Horario, new { @type = "date", @class = "form-control", @placeholder = "Horario", @required = "true", @id = "Horario" })
        </div>

        <label for="Duracion">Duracion en Horas</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Duracion, new { @type = "int", @class = "form-control", @placeholder = "Duracion", @required = "true", @id = "Duracion" })
        </div>

        <label for="CapacidadMaxima">Capacidad Maxima</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.CapacidadMaxima, new { @type = "int", @class = "form-control", @placeholder = "CapacidadMaxima", @required = "true", @id = "CapacidadMaxima" })
        </div>

        <label for="Estado">Estado</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Estado, new { @type = "int", @class = "form-control", @placeholder = "Estado", @required = "true", @id = "Estado" })
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a href="@Url.Action("ReadClases", "Clases")" class="btn btn-secondary">Cancelar</a>
    }
</div>

<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>