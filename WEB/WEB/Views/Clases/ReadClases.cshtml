@model List<WEB.Entities.Clase>

@{
    ViewData["Title"] = "ReadClases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clases Disponibles</h2>
        <a href="@Url.Action("CreateClase", "Clases")" class="btn btn-primary">
            Agregar Clase
        </a>
    </div>

<table id="tabla-Clases" class="table table-hover">
    <thead>
        <tr>
            <th>Id Clase</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Id Instructor</th>
            <th>Horario</th>
            <th>Duracion</th>
            <th>Capacidad Maxima</th>
            <th>Estado</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_clase</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.IdInstructor</td>
                <td>@item.Horario</td>
                <td>@item.Duracion</td>
                <td>@item.CapacidadMaxima</td>
                <td>@item.Estado</td>
                <td>
                        <a href="@Url.Action("UpdateClase", "Clases")" class="btn btn-primary">
                            Editar Clase
                        </a>
                        <a href="@Url.Action("DeleteClase", "Clases")" class="btn btn-primary">
                            Borrar Clase
                        </a>
                    
                 </td>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/ReadClases.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>