@model List<WEB.Entities.Clientes>

@{
    ViewData["Title"] = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista de Clientes</h2>
    <a href="@Url.Action("AgregarCliente", "Clientes")" class="btn btn-primary">
        Agregar Clientes
    </a>
</div>


    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="@Url.Action("ReadPlan", "Planes")" class="btn btn-primary">
            Ver los Planes
        </a>
    </div>

<table id="tabla-Clientes" class="table table-hover">
    <thead>
        <tr>
            <th>Id_cliente</th>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Correo</th>
            <th>Telefono</th>
            <th>Estado</th>
            <th>Plan</th>
            <th>Acciones</th>


        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_cliente</td>
                <td>@item.Nombre</td>
                <td>@item.Apellidos</td>
                <td>@item.Correo</td>
                <td>@item.Telefono</td>
                <td>@item.Estado</td>
                <td>@item.Plan</td>
                <td>Acciones</td>
                <td>
                    <a href="@Url.Action("ActualizarCliente", "Clientes", new { id = item.Id_cliente })" class="btn btn-warning btn-sm">
                        Actualizar
                    </a>
                    <a href="@Url.Action("EliminarCliente", "Clientes", new { id = item.Id_cliente })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de que deseas eliminar este cliente?');">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/validaciones.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>