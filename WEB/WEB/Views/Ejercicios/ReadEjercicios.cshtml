@model List<WEB.Entities.Ejercicio>

@{
    ViewData["Title"] = "ReadEjercicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Ejercicios</h2>
        <a href="@Url.Action("CreateEjercicio", "Ejercicios")" class="btn btn-primary">
            Agregar Ejercicio
        </a>
    </div>

<table id="tabla-Ejercicios" class="table table-hover">
    <thead>
        <tr>
            <th>Id Ejercicio</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Grupo Muscular</th>
            <th>Equipo Necesario</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_ejercicio</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.GrupoMuscular</td>
                <td>@item.EquipoNecesario</td>
                <td>
                        <a href="@Url.Action("UpdateEjercicio", "Ejercicios")" class="btn btn-primary">
                            Editar Ejercicio
                        </a>
                        <a href="@Url.Action("DeleteEjercicio", "Ejercicios")" class="btn btn-primary">
                            Borrar Ejercicio
                        </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/ReadEjercicio.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>