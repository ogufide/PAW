@model WEB.Entities.Ejercicio

@{
    ViewData["Title"] = "UpdateEjercicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2> Editar Ejercicio </h2>

<section class="min-vh-100 mb-8">
    <div class="container">
        <div class="row mt-lg-n10 mt-md-n11 mt-n10">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card z-index-0">

                    <div class="card-body">
                        @if (ViewBag.msj != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.msj
                            </div>
                        }
                        @using (Html.BeginForm("UpdateEjercicio", "Ejercicios", FormMethod.Post, new { id = "gymForm" }))
                        {
                            <label for="Nombre">Nombre</label>
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control form-control-user", @placeholder = "Nombre", @required = "true", @id = "Nombre" })
                            </div>

                            <label for="Descripcion">Descripcion</label>
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.Descripcion, new { @type = "text", @class = "form-control", @placeholder = "Descripcion", @required = "true", @id = "Descripcion" })
                            </div>

                            <label for="GrupoMuscular">Grupo Muscular</label>
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.GrupoMuscular, new { @type = "text", @class = "form-control", @placeholder = "GrupoMuscular", @required = "true", @id = "GrupoMuscular" })
                            </div>

                            <label for="EquipoNecesario">Equipo Necesario</label>
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.EquipoNecesario, new { @type = "text", @class = "form-control", @placeholder = "EquipoNecesario", @required = "true", @id = "EquipoNecesario" })
                            </div>

                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <a href="@Url.Action("ReadEjercicios", "Ejercicios")" class="btn btn-secondary">Cancelar</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
