@model List<WEB.Entities.Empleados>

@{
    ViewData["Title"] = "Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista de Empleados</h2>
    <a href="@Url.Action("AgregarEmpleado", "Empleados")" class="btn btn-primary">
        Agregar Empleados
    </a>
</div>


<table id="tabla-Empleados" class="table table-hover">
    <thead>
        <tr>
            <th>Id_empleado</th>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Fecha Nacimiento</th>
            <th>Genero</th>
            <th>Direccion</th>
            <th>Telefono</th>
            <th>Correo</th>
            <th>Puesto</th>
            <th>Fecha Contratacion</th>
            <th>Salario</th>
            <th>Estado</th>
            <th>Acciones</th>


        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_empleado</td>
                <td>@item.Nombre</td>
                <td>@item.Apellidos</td>
                <td>@item.FechaNacimiento</td>
                <td>@item.Genero</td>
                <td>@item.Direccion</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>
                <td>@item.Puesto</td>
                <td>@item.FechaContratacion</td>
                <td>@item.Salario</td>
                <td>@item.Estado</td>
                <td>Acciones</td>
                <td>
                    <a href="@Url.Action("ActualizarEmpleado", "Empleados", new { id = item.Id_empleado })" class="btn btn-warning btn-sm">
                        Actualizar
                    </a>
                    <a href="@Url.Action("EliminarEmpleado", "Empleados", new { id = item.Id_empleado })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de que deseas eliminar este cliente?');">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/validaciones.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>