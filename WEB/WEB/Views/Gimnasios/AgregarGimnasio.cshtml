@model WEB.Entities.Gimnasios

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    @if (ViewBag.msj != null)
    {
        <div class="alert alert-success" role="alert">
            @ViewBag.msj
        </div>
    }
    @using (Html.BeginForm("AgregarGimnasio", "Gimnasios", FormMethod.Post, new { id = "gymForm" }))
    {
        <label for="Nombre">Nombre</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control form-control-user", @placeholder = "Nombre", @required = "true", @id = "Nombre" })
        </div>

        <label for="Telefono">Teléfono</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Telefono, new { @type = "text", @class = "form-control", @placeholder = "Teléfono", @required = "true", @id = "Telefono" })
        </div>

        <label for="Direccion">Dirección</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Direccion, new { @type = "text", @class = "form-control", @placeholder = "Dirección", @required = "true", @id = "Direccion" })
        </div>

        <label for="Id_provincia">Provincia</label>
        <div class="mb-3">
            <select id="Id_provincia" name="Id_provincia" class="form-control" required>
                <option value="">Seleccionar Provincia</option>
                <!-- Opciones serán llenadas dinámicamente con JavaScript -->
            </select>
        </div>

        <div class="form-check form-check-info text-left">
            <input class="form-check-input" type="checkbox" value="" id="termsCheckbox">
            <label class="form-check-label" for="termsCheckbox">
                Estoy de acuerdo con los <a href="javascript:;" class="text-dark font-weight-bolder">Términos y Condiciones</a>
            </label>
        </div>

        <div class="">
            <button type="submit" class="btn bg-gradient-info w-100 mt-4 mb-0" id="registerButton">Registrar</button>
        </div>
    }
</div>

                    
     
    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
            console.log('Script de carga de provincias iniciado');
                fetch('/Provincias/ConsultarProvincia')
                    .then(response => response.json())
                    .then(data => {
                        let select = document.getElementById('Id_provincia');
                        data.forEach(provincia => {
                            let option = document.createElement('option');
                            option.value = provincia.id_provincia;
                            option.textContent = provincia.nombre;
                            select.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Error al cargar provincias:', error));
            });
        </script>
    }

                        
    






             