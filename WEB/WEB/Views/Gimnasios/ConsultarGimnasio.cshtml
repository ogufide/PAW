<script src="~/plantilla/js/validaciones.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>


<script>
    const confirmarEliminacion = (id_gimnasio) => {
        if (confirm("¿Estás seguro de que quieres eliminar este gimnasio?")) {
            EliminarGimnasio(id_gimnasio);
        }
    }

    const EliminarGimnasio = (id_gimnasio) => {
        fetch(`/Gimnasios/EliminarGimnasio/${id_gimnasio}`, {
            method: 'DELETE',
            headers: {
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            }
        })
            .then(response => {
                if (response.ok) {
                    return response.json();
                }
                throw new Error('Error en la respuesta del servidor');
            })
            .then(data => {
                alert("Gimnasio eliminado con éxito.");
                window.location.reload();
            })
            .catch(error => {
                console.error('Error al eliminar gimnasio:', error);
                alert("Error al eliminar el gimnasio: " + error.message);
            });
    }
</script>




