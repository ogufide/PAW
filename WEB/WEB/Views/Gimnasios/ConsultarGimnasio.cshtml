</div>
<div class="container">
    <div class="cards-container">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="card-header">
                    <h3>@item.Nombre</h3>
                </div>
                <div class="card-body">
                    <p><strong>Teléfono:</strong> @item.Telefono</p>
                    <p><strong>Provincia:</strong> @item.Provincia</p>
                    <p><strong>Dirección:</strong> @item.Direccion</p>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Gimnasio", "Home", new { Id_gimnasio = item.Id_gimnasio })" class="action-btn" aria-label="Ver detalles del gimnasio @item.Nombre">Ver Gimnasio</a>
