@model WEB.Entities.Plan
@{
    ViewData["Title"] = "GimnasioSuscripciones";
    Layout = "~/Views/Shared/_LayoutGimnasio.cshtml";
}


    <style>
        /* Estilos previos... */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        .modal-content {
            background-color: #fefefe;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 600px;
        }
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
    </style>

    <div class="programa">
        <img src="" alt="">
        <div class="descripcion">
            <!-- Muestra el nombre del plan -->
            <h2>@Model.Nombre</h2>

            <!-- Muestra la descripción del plan -->
            <p>@Model.Descripcion</p>

            <!-- Muestra el precio del plan, formateado como moneda -->
            <p><strong>Precio:</strong> @Model.Precio.HasValue ? Model.Precio.Value.ToString("C") : "No disponible"</p>

            <!-- Información adicional basada en el estado del plan -->
            <p><strong>Estado:</strong> @(Model.Estado.HasValue ? (Model.Estado.Value == 1 ? "Activo" : "Inactivo") : "No definido")</p>
        </div>

        <button class="suscribete" onclick="mostrarSuscripciones()">Suscríbete para ver</button>
    </div>

    <div id="modalSuscripciones" class="modal">
        <div class="modal-content">
            <span class="close" onclick="cerrarModal()">&times;</span>
            <h2>Elige tu plan de suscripción</h2>
            <div class="planes">
                <div class="plan">
                    <h3>PLAN INDIVIDUAL</h3>
                    <p class="plan-price">Desde $75/mes + IVA</p>
                    <ul>
                        <li>Acceso ilimitado al gimnasio</li>
                        <li>Clases grupales incluidas</li>
                        <li>Asesoramiento nutricional</li>
                    </ul>
                    <a href="#" class="btn-gold">Suscribirse</a>
                </div>
                <div class="plan">
                    <h3>PLAN FAMILIAR</h3>
                    <p class="plan-price">Desde $70/mes + IVA por persona</p>
                    <ul>
                        <li>Acceso para toda la familia</li>
                        <li>Clases grupales incluidas</li>
                        <li>Descuentos en servicios adicionales</li>
                    </ul>
                    <a href="#" class="btn-gold">Suscribirse</a>
                </div>
                <div class="plan">
                    <h3>PLAN PREMIUM</h3>
                    <p class="plan-price">Desde $120/mes + IVA</p>
                    <ul>
                        <li>Acceso ilimitado al gimnasio</li>
                        <li>Clases grupales ilimitadas</li>
                        <li>Entrenamiento personal mensual</li>
                        <li>Asesoramiento nutricional avanzado</li>
                        <li>Acceso a áreas exclusivas</li>
                    </ul>
                    <a href="#" class="btn-gold">Suscribirse</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function mostrarSuscripciones() {
            document.getElementById('modalSuscripciones').style.display = 'block';
        }

        function cerrarModal() {
            document.getElementById('modalSuscripciones').style.display = 'none';
        }

        // Cerrar modal al hacer clic fuera de él
        window.onclick = function(event) {
            if (event.target == document.getElementById('modalSuscripciones')) {
                cerrarModal();
            }
        }
    </script>
