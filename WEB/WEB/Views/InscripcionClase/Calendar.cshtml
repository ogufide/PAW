@using WEB.Entities
@model List<Calendar>

@{
    ViewBag.Title = "Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <!-- Incluye las bibliotecas necesarias -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar/index.global.min.js"></script>

    <!-- Estilos CSS para el calendario -->
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        #calendar {
            width: 100%;
            height: 600px;
            background-color: #fff;
            margin-bottom: 20px;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .header h1 {
                margin: 0;
                color: #1a76d1;
            }

            .header .add-btn {
                background-color: #1a76d1;
                color: white;
                border: none;
                padding: 10px 20px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 16px;
            }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            padding-top: 50px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background-color: #f9f9f9;
            margin: auto;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
            border-top: 5px solid #1a76d1;
            width: 50%;
            max-width: 600px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

            .close:hover, .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        .modal-btn {
            background-color: #1a76d1;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-right: 20px;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .fc-prev-button, .fc-next-button, .fc-today-button, .fc-button-primary {
            background-color: #1a76d1 !important;
            color: white !important;
            border: none !important;
            border-radius: 5px;
            padding: 5px 10px;
            margin-right: 5px;
            cursor: pointer;
        }
    </style>

    <script>
        $(document).ready(function () {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                events: @Html.Raw(Json.Serialize(Model)),
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                eventClick: function (info) {
                    showEventInfo(info.event);
                }
            });

            calendar.render();

            function showEventInfo(event) {
                const modal = document.getElementById('eventModal');
                const modalContent = document.getElementById('modalContent');

                const startTimeFormatted = event.start.toLocaleDateString('es-ES');
                const endTimeFormatted = event.end ? event.end.toLocaleDateString('es-ES') : 'No disponible';

                modalContent.innerHTML = `
                                            <h2>Información de la inscripción</h2>
                                            <p><strong>Nombre del Cliente:</strong> ${event.extendedProps.nombreCliente}</p>
                                            <p><strong>Clase:</strong> ${event.title}</p>
                                            <p><strong>Fecha de Inicio:</strong> ${startTimeFormatted}</p>
                                            <p><strong>Fecha de Fin:</strong> ${endTimeFormatted}</p>
                                            <button id="eliminarBtn" class="modal-btn" data-inscripcion-id="${event.extendedProps.inscripcionId}">Eliminar inscripción</button>
                                            <button id="GestionarBtn" class="modal-btn" data-inscripcion-id="${event.extendedProps.inscripcionId}">Gestionar inscripción</button>
                                        `;

                modal.style.display = 'block';

                document.getElementById('eliminarBtn').onclick = function () {
                    var inscripcionId = event.extendedProps.inscripcionId;
                    var deleteUrl = '/InscripcionClase/DeleteInscripcion?Id_inscripcion=' + inscripcionId;
                    window.location.href = deleteUrl;
                };

                document.getElementById('GestionarBtn').onclick = function () {
                    var inscripcionId = event.extendedProps.inscripcionId;
                    var editUrl = '/InscripcionClase/UpdateInscripcion/' + inscripcionId;
                    window.location.href = editUrl;
                };

                document.getElementById('closeModalButton').onclick = function () {
                    modal.style.display = 'none';
                };
            }

            window.onclick = function (event) {
                const modal = document.getElementById('eventModal');
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            };
        });
    </script>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Calendario de Inscripciones</h1>
            <button class="add-btn" onclick="window.location.href='/InscripcionClase/AgregarClase'">Agregar Inscripción</button>
        </div>
        <div id="calendar"></div>
    </div>

    <div id="eventModal" class="modal">
        <div class="modal-content" id="modalContent">
            <span id="closeModalButton" class="close">&times;</span>
        </div>
    </div>
</body>
</html>
