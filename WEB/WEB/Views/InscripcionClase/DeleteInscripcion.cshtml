@model WEB.Entities.InscripcionClases

@{
    ViewData["Title"] = "Eliminar Inscripción de Clases";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<main class="main-content mt-0">
    <section class="min-vh-100 mb-8">
        <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('@Url.Content("~/plantilla/img/gym/14.jpg")');">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center mx-auto">
                        <h1 class="text-white mb-2 mt-5">Confirmar Eliminación</h1>
                        <p class="text-lead text-white">¿Estás seguro de que deseas eliminar esta inscripción?</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row mt-lg-n10 mt-md-n11 mt-n10">
                <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                    <div class="card shadow-sm border-0 rounded-lg">
                        <div class="card-body">
                            @if (ViewBag.msj != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    @ViewBag.msj
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @using (Html.BeginForm("DeleteInscripcion", "InscripcionClase", FormMethod.Post, new { id = "deleteForm" }))
                            {
                                @Html.HiddenFor(m => m.Id_inscripcion)
                                <div class="form-group mb-4">
                                    @Html.Label("Nombre del cliente")
                                    @Html.TextBoxFor(m => m.Id_cliente, Model.SelectedNombreCliente, new { @class = "form-control", @readonly = "readonly" })
                                </div>

                                <div class="form-group mb-4">
                                    @Html.Label("Nombre de la clase")
                                    @Html.TextBoxFor(m => m.IdClase, Model.SelectedNombreClase, new { @class = "form-control", @readonly = "readonly" })
                                </div>

                                <div class="form-group mb-4">
                                    @Html.LabelFor(m => m.FechaInscripcion, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.FechaInscripcion, "{0:dd/MM/yyyy}", new { @class = "form-control", @readonly = "readonly" })

                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-danger w-100 mt-4 mb-2">Eliminar</button>
                                    <a href="@Url.Action("Calendar", "InscripcionClase")" class="btn btn-secondary w-100 mt-2 mb-0">Cancelar</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
