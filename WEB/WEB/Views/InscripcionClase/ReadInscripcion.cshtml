@model List<WEB.Entities.InscripcionClases>

@{
    ViewData["Title"] = "Inscripciones de Clases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content mt-0">
    <section class="container">
        <div class="d-flex justify-content-between mb-4">
            <h1>@ViewData["Title"]</h1>
            <a class="btn btn-success" href="@Url.Action("AgregarClase", "InscripcionClase")">
                <i class="fa fa-plus"></i> Agregar Inscripción
            </a>
        </div>

        <table id="tabla-Clases" class="table table-hover">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Clase</th>
                    <th>Fecha de Inscripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SelectedNombreCliente</td>
                        <td>@item.SelectedNombreClase</td>
                        <td>@item.FechaInscripcion?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a class="btn btn-primary" href="@Url.Action("UpdateInscripcion", "InscripcionClase", new { Id_inscripcion = item.Id_inscripcion })">
                                <i class="fa fa-pen"></i>
                            </a>

                            <a class="btn btn-danger" href="@Url.Action("DeleteInscripcion", "InscripcionClase", new { Id_inscripcion = item.Id_inscripcion })">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</main>

<script src="~/plantilla/js/jquery.min.js"></script>
<script src="~/plantilla/js/ReadInscripcion.js"></script>
