@model List<WEB.Entities.InscripcionClases>

@{
    ViewData["Title"] = "Inscripcion Clases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table id="tabla-Clases" class="table table-hover">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Clase</th>
            <th>Fecha de Inscripcion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SelectedNombreCliente</td>
                <td>@item.SelectedNombreClase</td>
                <td>@item.FechaInscripcion?.ToString("dd/MM/yyyy")</td>

                <td>
                    <button type="button" class="btn btn-primary Modales" data-toggle="modal" data-target="#ModalInscripcion"
                            data-id="@item.Id_inscripcion" data-name="@item.SelectedNombreClase">
                        <i class="fa fa-pen"></i>
                    </button>

                    <a class="btn btn-primary" href="@Url.Action("UpdateInscripcion", "InscripcionClase", new { q = item.Id_inscripcion })">
                        <i class="fa fa-user"></i>
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>

<script src="~/plantilla/js/ReadInscripcion.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>
