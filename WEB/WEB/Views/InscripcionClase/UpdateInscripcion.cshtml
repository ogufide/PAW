@model WEB.Entities.InscripcionClases

@{
    ViewData["Title"] = "Pagina Actualizar Inscripciones de clases";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<main class="main-content  mt-0">
    <section class="min-vh-100 mb-8">
        <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('@Url.Content("~/plantilla/img/gym/14.jpg")');">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-5 text-center mx-auto">
                        <h1 class="text-white mb-2 mt-5">¡Bienvenido!</h1>
                        <p class="text-lead text-white">Ingresa tus datos!</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row mt-lg-n10 mt-md-n11 mt-n10">
                <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                    <div class="card z-index-0">

                        <div class="card-body">
                            @if (ViewBag.msj != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @ViewBag.msj
                                </div>
                            }
                            @using (Html.BeginForm("UpdateInscripcion", "InscripcionClase", FormMethod.Post , new { id = "classForm" }))
                            {
                                @Html.HiddenFor(m => m.Id_inscripcion)

                                @Html.Label("Clientes Disponibles")
                                <div class="input-group mb-3">
                                    @Html.DropDownListFor(m => m.Id_cliente, Model.NombreCliente ?? new List<SelectListItem>(), new { @class = "form-control" })
                                </div>
                                @Html.Label("Clases disponibles")
                                <div class="input-group mb-3">
                                    @Html.DropDownListFor(m => m.IdClase, Model.NombreClase ?? new List<SelectListItem>(), new { @class = "form-control" })
                                </div>
                               

                                <div class="">
                                    <button type="submit" class="btn bg-gradient-info w-100 mt-4 mb-0" id="updateButton">Actualizar</button>
                                    <a href="@Url.Action("Calendar", "InscripcionClase")" class="btn btn-secondary w-100 mt-2 mb-0">Cancelar</a>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
