@model WEB.Entities.Membresia

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    @using (Html.BeginForm("CreateMembresia", "Membresia", FormMethod.Post, new { id = "formAgregar" }))
    {
        <div class="form-group">
            <label for="Nombre">Nombre</label>
            <div class="mb-3">
                @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control", @placeholder = "Nombre de la membresía", @required = "true", @id = "Nombre" })
            </div>
        </div>

        <div class="form-group">
            <label for="Descripcion">Descripción</label>
            <div class="mb-3">
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", @rows = "3", @placeholder = "Descripción de la membresía", @required = "true", @id = "Descripcion" })
            </div>
        </div>

        <div class="form-group">
            <label for="Precio">Precio</label>
            <div class="mb-3">
                @Html.TextBoxFor(m => m.Precio, new { @type = "number", @class = "form-control", @placeholder = "Precio de la membresía", @required = "true", @id = "Precio" })
            </div>
        </div>

        <div class="form-group">
            <label for="Plan">Plan</label>
            <div class="mb-3">
                @Html.TextBoxFor(m => m.Plan_codigo, new { @type = "text", @class = "form-control", @placeholder = "Plan de la membresía", @required = "true", @id = "Plan" })
            </div>
        </div>

        <div class="form-group">
            <label for="Cliente_codigo">Código de Cliente</label>
            <div class="mb-3">
                @Html.TextBoxFor(m => m.Cliente_codigo, new { @type = "text", @class = "form-control", @placeholder = "Código del cliente", @required = "true", @id = "Cliente_codigo" })
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
    }
</div>

<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>

