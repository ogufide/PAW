@model List<WEB.Entities.Membresia>

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Membresías</h2>
        <a href="@Url.Action("CreateMembresia", "Membresia")" class="btn btn-primary">
            Agregar Membresía
        </a>
    </div>

    <table id="tabla-Membresias" class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Plan</th>
                <th>Código de cliente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Precio</td>
                    <td>@item.Plan_codigo</td>
                    <td>@item.Cliente_codigo</td>
                    <td>


                        <a class="btn btn-danger" href="@Url.Action("DeleteMembresia", "Membresia", new { Id_membresia = item.Id_membresia })">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="~/plantilla/js/ConsultaUsuarios.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>
