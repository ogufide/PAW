@model WEB.Entities.Plan

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    @using (Html.BeginForm("CreatePlan", "Planes", FormMethod.Post, new { id = "gymForm" }))
    {

        <label for="Nombre">Nombre</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control form-control-user", @placeholder = "Nombre", @required = "true", @id = "Nombre" })
        </div>

        <label for="Precio">Precio</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Precio, new { @type = "int", @class = "form-control", @placeholder = "Precio", @required = "true", @id = "Precio" })
        </div>

        <label for="Descripcion">Descripcion</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Descripcion, new { @type = "text", @class = "form-control", @placeholder = "Descripcion", @required = "true", @id = "Descripcion" })
        </div>

        <label for="Gimnasio_codigo">Gimnasio_codigo</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Gimnasio_codigo, new { @type = "int", @class = "form-control", @placeholder = "Gimnasio_codigo", @required = "true", @id = "Gimnasio_codigo" })
        </div>

        <label for="Estado">Estado</label>
        <div class="mb-3">
            @Html.TextBoxFor(m => m.Estado, new { @type = "int", @class = "form-control", @placeholder = "Estado", @required = "true", @id = "Estado" })
        </div>

        <div class="">
            <button type="submit" class="btn bg-gradient-info w-100 mt-4 mb-0" id="registerButton">Crear</button>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>