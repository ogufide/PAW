@model List<WEB.Entities.Plan>

@{
    ViewData["Title"] = "ReadPlan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Planes Disponibles</h2>
        <a href="@Url.Action("CreatePlan", "Planes")" class="btn btn-primary">
            Agregar un Plan.
        </a>
    </div>

<table id="tabla-Plan" class="table table-hover">
    <thead>
        <tr>
            <th>Id Plan</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Descripcion</th>
            <th>Gimnasio</th>
            <th>Estado</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_plan</td>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@item.Descripcion</td>
                <td>@item.Gimnasio_codigo</td>
                <td>@item.Estado</td>
                    <td>
                        <button class="btn btn-secondary btn-sm" title="Editar" onclick="editItem()">
                            Editar
                        </button>
                        <button class="btn btn-danger btn-sm" title="Eliminar" onclick="confirmDelete()">
                            Eliminar
                        </button>

                    </td>>
            </tr>
        }
    </tbody>
</table>


<script src="~/plantilla/js/ReadPlan.js"></script>
<script src="~/plantilla/js/jquery.min.js"></script>