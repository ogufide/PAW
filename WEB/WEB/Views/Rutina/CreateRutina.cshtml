@model WEB.Entities.Rutina

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="min-vh-100 mb-8">
    <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('@Url.Content("~/plantilla/img/gym.jpeg")');">
        <span class="mask bg-gradient-dark opacity-6"></span>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5 text-center mx-auto">
                    <h1 class="text-white mb-2 mt-5">Inscripción de Rutinas</h1>
                    <p class="text-lead text-white">Llena el siguiente formulario para inscribir una rutina.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row mt-lg-n10 mt-md-n11 mt-n10">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card z-index-0">
                    <div class="card-body">
                        @if (ViewBag.msj != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.msj
                            </div>
                        }
                        @using (Html.BeginForm("CreateRutina", "Rutina", FormMethod.Post, new { id = "classForm" }))
                        {
                            <label for="planDropdown">Plan</label>
                            <div class="mb-3">
                                @Html.DropDownListFor(m => m.Id_plan, Model.SelectedNombrePlan, "Selecciona un plan", new { @class = "form-control", @id = "planDropdown" })
                            </div>
                            <div class="form-group">
                                <label for="Nombre">Nombre</label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "form-control", @placeholder = "Nombre de la rutina", @required = "true", @id = "Nombre" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Descripcion, "Descripción", htmlAttributes: new { @class = "form-label" })
                                <div class="mb-3">
                                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", @rows = "4", @placeholder = "Ingresa una descripción detallada", @required = "true", @maxlength = "100", @id = "descripcion" })
                                    <small id="charCount" class="form-text text-muted">0/100 caracteres utilizados.</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="Nombre">Dia De La Semana</label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.DiaSemana, new { @type = "text", @class = "form-control", @placeholder = "Dia de la semana", @required = "true", @id = "DiaSemana" })
                                </div>
                            </div>


                            <div>
                                <button type="submit" class="btn bg-gradient-info w-100 mt-4 mb-0" id="registerButton">Inscribir</button>
                                <a href="@Url.Action("ReadRutina", "Rutina")" class="btn btn-secondary w-100 mt-2 mb-0">Cancelar</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#descripcion').on('input', function () {
                var charCount = $(this).val().length;
                $('#charCount').text(charCount + '/100 caracteres utilizados.');
            });
        });
    </script>
}