@model WEB.Entities.Rutina

@{
    ViewData["Title"] = "Actualizar Rutinas";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<main class="main-content mt-0">
    <section class="min-vh-100 mb-8">
        <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg"
             style="background-image: url('@Url.Content("~/plantilla/img/gym/14.jpg")'); background-size: cover; background-position: center;">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-5 text-center mx-auto">
                        <h1 class="text-white mb-2 mt-5">¡Actualizacion de Rutina!</h1>
                        <p class="text-lead text-white">Completa los campos para actualizar la información de la rutina.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row mt-lg-n10 mt-md-n11 mt-n10 justify-content-center">
                <div class="col-xl-5 col-lg-6 col-md-8">
                    <div class="card shadow-lg">
                        <div class="card-header bg-gradient-info text-white text-center py-3">
                            <h4 class="mb-0">Formulario de Actualización</h4>
                        </div>
                        <div class="card-body p-4">
                            @if (ViewBag.msj != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @ViewBag.msj
                                </div>
                            }
                            @using (Html.BeginForm("UpdateRutina", "Rutina", FormMethod.Post, new { id = "classForm" }))
                            {
                                @Html.HiddenFor(m => m.Id_rutina)

                                <div class="form-group">
                                    @Html.Label("Id_plan", "Planes Disponibles", htmlAttributes: new { @class = "form-label" })
                                    <div class="input-group mb-3">
                                        @Html.DropDownListFor(m => m.Id_plan, Model.SelectedNombrePlan ?? new List<SelectListItem>(), new { @class = "form-control" })
                                    </div>
                                </div>


                                <div class="form-group">
                                    @Html.LabelFor(m => m.Nombre, "Nombre de la Rutina", htmlAttributes: new { @class = "form-label" })
                                    <div class="mb-3">
                                        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", @placeholder = "Ingresa el nombre de la rutina", @required = "true" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Descripcion, "Descripción", htmlAttributes: new { @class = "form-label" })
                                    <div class="mb-3">
                                        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", @rows = "4", @placeholder = "Ingresa una descripción detallada", @required = "true", @maxlength = "100", @id = "descripcion" })
                                        <small id="charCount" class="form-text text-muted">0/100 caracteres utilizados.</small>
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.DiaSemana, "Día de la Semana", htmlAttributes: new { @class = "form-label" })
                                    <div class="mb-3">
                                        @Html.TextBoxFor(m => m.DiaSemana, new { @class = "form-control", @placeholder = "Ingresa el día de la semana", @required = "true" })
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <button type="submit" class="btn bg-gradient-info w-45 mt-4 mb-0">Actualizar</button>
                                    <a href="@Url.Action("ReadRutina", "Rutina")" class="btn btn-secondary w-45 mt-4 mb-0">Cancelar</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#descripcion').on('input', function () {
                var charCount = $(this).val().length;
                $('#charCount').text(charCount + '/100 caracteres utilizados.');
            });
        });
    </script>
}