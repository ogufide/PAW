@model WEB.Entities.Rol

@{
    ViewData["Title"] = "CreateRol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear Rol</h2>

<div class="register-box">
    <div class="card">
        <div class="card-body register-card-body">
            <p class="login-box-msg">Registro de Roles</p>

            @if (ViewBag.msj != null)
            {
                <div class="alert alert-secondary" style="text-align:center" role="alert">
                    @ViewBag.msj
                </div>
            }

            @using (Html.BeginForm("CreateRol", "Usuario"))
            {
                <div class="input-group mb-3">
                    @Html.TextBoxFor(m => m.descripcion, new { @type = "text", @class = "form-control", @placeholder = "Descripcion" })
                </div>
                <div class="row">
                    <div class="col-8">
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Guardar</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
