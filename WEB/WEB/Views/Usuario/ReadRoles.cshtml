@model List<WEB.Entities.Rol>

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Lista de Roles</h2>


<table id="tabla-Roles" class="table table-hover">
    <thead>
        <tr>
            <th>Identificador del Rol</th>
            <th>Descipción</th>
            <th>Estado</th>



        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_rol</td>
                <td>@item.descripcion</td>
                <td>@item.Estado</td>
            </tr>
        }
    </tbody>
</table>

