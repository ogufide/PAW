@model List<WEB.Entities.Rol>

@{
    ViewData["Title"] = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Lista de Roles</h2>

<a href="@Url.Action("CreateRol", "Usuario")" class="btn btn-success mb-3">
    Agregar Nuevo Rol
</a>

<table id="tabla-Roles" class="table table-hover">
    <thead>
        <tr>
            <th>Identificador del Rol</th>
            <th>Descripción</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_rol</td>
                <td>@item.descripcion</td>
                <td>
                    @if (item.Estado == "true")
                    {
                        <span>Inactivo</span>
                    }
                    else
                    {
                        <span>Activo</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

