@model WEB.Entities.Usuario

@{
    ViewData["Title"] = "Recuperar cuenta";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<main class="main-content  mt-0">
    <section class="min-vh-100 mb-8">
        <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('@Url.Content("~/plantilla/img/gym/16.jpg")');">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-5 text-center mx-auto">
                        <h1 class="text-white mb-2 mt-5">¡Bienvenido!</h1>
                        <p class="text-lead text-white">Ingresa tu correo para recuperar tu cuenta.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row mt-lg-n10 mt-md-n11 mt-n10">
                <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                    <div class="card z-index-0">
                        <div class="card-body">
                            @if (ViewBag.msj != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @ViewBag.msj
                                </div>
                            }

                            @using (Html.BeginForm("RecuperarAcceso", "Usuario"))
                            {
                                <div class="input-group mb-3">
                                    @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", @placeholder = "Identificación" })
                                </div>

                                <div class="row">
                                    <div class="col-8">
                                    </div>
                                    <div class="col-4">
                                        <button type="submit" class="btn btn-primary btn-block">Procesar</button>
                                    </div>
                                </div>
                            }
                            <div class="card-footer text-center pt-0 px-lg-2 px-1">
                                <p class="mb-4 text-sm mx-auto">
                                    <a href="@Url.Action("Login","Home")" class="text-info text-gradient font-weight-bold">Quiero iniciar sesión</a>
                                </p>
                                <p class="mb-4 text-sm mx-auto">
                                    <a href="@Url.Action("CreateUsuario","Usuario")" class="text-info text-gradient font-weight-bold">Quiero registrarme</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </section>
</main>

<script src="~/plantilla/js/registrousuarios.js"></script>
